# Copy to .secrets/.env and fill in credentials. Never commit the real file.
# Existing shell variables take precedence over .env files.
HYPE_DB_BACKEND=aiven
AIVEN_DB_URI="postgresql://hype_sync:REPLACE_ME@YOUR_AIVEN_HOST:PORT/defaultdb?sslmode=require"
AIVEN_DB_HOST="YOUR_AIVEN_HOST"
# One physical line, with literal \n between PEM lines. Raw multiline PEM also
# works when supplied as an environment variable (e.g. an Actions Secret).
AIVEN_DB_CA_CERTIFICATE="-----BEGIN CERTIFICATE-----\nREPLACE_WITH_CA_BODY\n-----END CERTIFICATE-----"

# Original DB remains available only for explicit migration/rollback operations.
# HYPE_DB_BACKEND=supabase requires SUPABASE_DB_URL.
# SUPABASE_DB_URL="postgresql://..."
# For offline SQLite work, set HYPE_DB_BACKEND=sqlite.
